  "training": {
    "steps": 200, "prompts_per_step": 16, "group_size": 8, "micro_batch_size": 16,
    "warmup_steps": 30, "weight_decay": 0.01, "max_grad_norm": 1.0, "max_prompt_tokens": 480,
