    {"id": "grpo_lr1e4", "method": "grpo", "lr": 0.0001, "beta": 0.0},
    {"id": "sft_self_lr1e4", "method": "sft_self", "lr": 0.0001},
    {"id": "sft_gold_lr1e5", "method": "sft_gold", "lr": 1e-05},
    {"id": "grpo_lr1e5", "method": "grpo", "lr": 1e-05, "beta": 0.0},
    {"id": "rft_lr1e5", "method": "rft", "lr": 1e-05},
    {"id": "grpo_kl_lr1e5", "method": "grpo", "lr": 1e-05, "beta": 0.05}
  ]
}
